{
  "name": "JournalEntry",
  "type": "object",
  "properties": {
    "content": {
      "type": "string"
    },
    "mood": {
      "type": "string",
      "enum": [
        "positive",
        "neutral",
        "negative",
        "very_negative"
      ],
      "default": "neutral"
    },
    "tags": {
      "type": "string"
    }
  },
  "required": [
    "content"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}